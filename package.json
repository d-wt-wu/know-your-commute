{
  "name": "know-your-commute",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check:neon && npm --prefix web run build",
    "check:neon": "node web/node_modules/typescript/bin/tsc --project tsconfig.neon.json",
    "start": "node scripts/start.mjs",
    "start:local": ".venv/bin/python scripts/run_local.py",
    "neon:plan": "npx --yes neon@latest config plan",
    "neon:deploy": "npx --yes neon@latest deploy"
  },
  "dependencies": {
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15"
  }
}
